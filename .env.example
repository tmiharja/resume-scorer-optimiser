# Copy to .env.local for local development. Never commit real values.
# In production (VERCEL_ENV=production) the app refuses to start if a required
# variable is missing. Locally, missing services fall back to mocks / no-ops.

# --- Anthropic (required in production) ---
ANTHROPIC_API_KEY=

# Per-agent model. Allowed: claude-haiku-4-5 (default), claude-sonnet-5
MODEL_EXTRACTOR=claude-haiku-4-5
MODEL_CRITIC=claude-haiku-4-5
MODEL_MATCHER=claude-haiku-4-5
MODEL_REWRITER=claude-haiku-4-5
MODEL_VERIFIER=claude-haiku-4-5

# --- Neon Postgres (required in production; set by the Vercel Marketplace integration) ---
DATABASE_URL=
# Direct connection, used for migrations if present (also set by the integration)
# DATABASE_URL_UNPOOLED=

# --- Upstash Redis (required in production) ---
# Either the UPSTASH_* pair or the KV_* pair set by the Vercel Marketplace integration.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# --- Rate limiting and budget ---
# Random secret, at least 32 chars, e.g. `openssl rand -hex 32`. Required in production.
IP_HASH_SALT=
RATE_LIMIT_PER_DAY=5
MONTHLY_BUDGET_USD=18

# --- Testing ---
# 1 = use the mocked LLM layer (e2e tests, offline dev). Rejected in production.
LLM_MOCK=0

# --- Public site config ---
# Where the "Built by toninmotion" footer credit links to (optional).
NEXT_PUBLIC_PORTFOLIO_URL=
